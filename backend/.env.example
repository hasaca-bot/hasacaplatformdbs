# =============================================
# HASACA Platform — Environment configuration
# Copy this file to "backend/.env" for local development.
# In production (Render), set these as real environment variables instead.
# NEVER commit a real .env — it is gitignored.
# =============================================

# --- Environment ---
NODE_ENV=development

# --- Database ---
# LEAVE BLANK for local development -> uses a zero-config local SQLite file
# (backend/dayikatik.db). Set a PostgreSQL connection string for production:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Auth ---
# Secret used to sign session tokens. If blank, a secret is auto-generated
# and saved to data/secret.json on first run. Set a strong value in production.
AUTH_SECRET=

# Optional: fix the root (platform owner) password instead of an auto-generated one.
# ROOT_PASSWORD=change-me-strong-password

# --- Google Sign-In ---
# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client ID -> Web application).
# This value is NOT secret (Client IDs are meant to be public, unlike API keys) — it is safe to
# expose to the frontend via /api/platform-config. Leave blank to hide the Google button entirely.
# GOOGLE_CLIENT_ID=

# --- Server ---
PORT=12000

# --- Platform domain (production) ---
# Used to build QR URLs and resolve tenant subdomains, e.g. restaurant1.hasaca.com
# PLATFORM_DOMAIN=hasaca.com
# PLATFORM_ORIGIN=https://hasaca.com

# --- Web Push (VAPID) ---
# If blank, keys are auto-generated into data/vapid.json on first run.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
